ations" }}{SECT 0 {PARA 4 "" 0 "" {TEXT -1 65 "Reverse State Substitut
ion for Pretty Display of the Solved EOM's" }}{EXCHG {PARA 0 "" 0 "" 
{TEXT -1 21 "only for pretty print" }}{PARA 0 "> " 0 "" {MPLTEXT 1 0 
100 "subs_Xq_rev := \{ seq( X[i] = q[i], i=1..Nq ) \}:\nsubs_Xqd_rev :
= \{ seq( X[i+Nq] = qd[i], i=1..Nq ) \}:" }}}{EXCHG {PARA 0 "> " 0 "" 
{MPLTEXT 1 0 65 "#subs_U_rev := \{ U[1] = V[m] \}: \nsubs_U_rev := \{ \+
U[1] = tau[m] \}:" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 98 "eom_co
llect_list := \{ seq( diff( q[i], t ), i=1..Nq ), seq( q[i], i=1..Nq )
, J[r], J[p1], J[p2] \};" }}{PARA 11 "" 1 "" {XPPMATH 20 "6#>%1eom_col
lect_listG<+&%\"JG6#%#p1G&F'6#%#p2G&F'6#%\"rG-%$phiG6#%\"tG-%&alphaGF2
-%%diffG6$F0F3-F76$F4F3-F76$-%&thetaGF2F3F=" }}}{PARA 0 "" 0 "" {TEXT 
